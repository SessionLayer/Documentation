{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD004": { "style": "dash" },
    "MD046": { "style": "fenced" },
    "MD036": false
  },
  "globs": ["**/*.md"],
  // product/ is where CI checks out the source-of-truth repos for the drift gates.
  "ignores": ["node_modules/**", "product/**"]
}
